
@model Practical6.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<center>
    <h1>Product Details</h1>

    <table border="1" cellpadding="10">
        <tr>
            <th>Product ID</th>
            <td>@Model.Id</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <th>Category</th>
            <td>@Model.Category</td>
        </tr>
        <tr>
            <th>Price</th>
            <td>₹@Model.Price</td>
        </tr>
        <tr>
            <th>Stock</th>
            <td>@Model.Stock</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>@Model.Description</td>
        </tr>
    </table>

    <p>
        <a asp-controller="Product" asp-action="Index">Back to Catalog</a>
    </p>
</center>