@model Practical9.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<div class="page-heading">
    <h1>Add New Student</h1>
    <p>Enter student and placement information.</p>
</div>

<div class="form-section">

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-message"></div>

        <div class="form-group">
            <label asp-for="StudentName">Student Name</label>
            <input asp-for="StudentName"
                   class="form-control"
                   placeholder="Enter student name" />
            <span asp-validation-for="StudentName"
                  class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Department">Department</label>
            <select asp-for="Department" class="form-control">
                <option value="">Select Department</option>
                <option value="CSE">CSE</option>
                <option value="AIML">AIML</option>
                <option value="IT">IT</option>
                <option value="ECE">ECE</option>
                <option value="MECH">MECH</option>
            </select>
            <span asp-validation-for="Department"
                  class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Company">Company Name</label>
            <input asp-for="Company"
                   class="form-control"
                   placeholder="Enter company name" />
            <span asp-validation-for="Company"
                  class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Package">Package (LPA)</label>
            <input asp-for="Package"
                   type="number"
                   step="0.1"
                   min="0"
                   class="form-control"
                   placeholder="Enter package" />
            <span asp-validation-for="Package"
                  class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="PlacementStatus">Placement Status</label>
            <select asp-for="PlacementStatus" class="form-control">
                <option value="Placed">Placed</option>
                <option value="Not Placed">Not Placed</option>
            </select>
        </div>

        <div class="form-buttons">
            <button type="submit" class="primary-btn">
                Save Student
            </button>

            <a asp-action="Index" class="secondary-btn">
                Cancel
            </a>
        </div>

    </form>

</div>
