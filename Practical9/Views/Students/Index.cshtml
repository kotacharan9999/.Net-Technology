@model List<Practical9.Models.Student>

@{
    ViewData["Title"] = "Dashboard";

    int total = Model.Count;
    int placed = Model.Count(s => s.PlacementStatus == "Placed");
    int notPlaced = total - placed;

    decimal averagePackage = placed > 0
        ? Model.Where(s => s.PlacementStatus == "Placed")
               .Average(s => s.Package)
        : 0;
}

<div class="page-heading">
    <h1>Placement Dashboard</h1>
    <p>Manage student placement records and company information.</p>
</div>

<div class="stats">

    <div class="stat-card">
        <p>Total Students</p>
        <h2>@total</h2>
    </div>

    <div class="stat-card">
        <p>Placed Students</p>
        <h2>@placed</h2>
    </div>

    <div class="stat-card">
        <p>Not Placed</p>
        <h2>@notPlaced</h2>
    </div>

</div>

<div class="section">

    <div class="section-heading">
        <h2>Student Records</h2>

        <a asp-action="Create" class="primary-btn">
            + Add Student
        </a>
    </div>

    <form asp-action="Index" method="get" class="filter-form">

        <label for="department">Department:</label>

        <select name="department" id="department">

            <option value="">All Departments</option>

            @foreach (var dept in ViewBag.Departments)
            {
                if (ViewBag.SelectedDepartment == dept)
                {
                    <option value="@dept" selected>@dept</option>
                }
                else
                {
                    <option value="@dept">@dept</option>
                }
            }

        </select>

        <button type="submit">Filter</button>

        <a asp-action="Index" class="secondary-btn">Reset</a>

    </form>

    <div class="table-wrap">

        <table class="student-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Student Name</th>
                    <th>Department</th>
                    <th>Company</th>
                    <th>Package (LPA)</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty-message">
                            No student records found.
                        </td>
                    </tr>
                }

                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.StudentID</td>
                        <td><strong>@student.StudentName</strong></td>
                        <td>@student.Department</td>
                        <td>@student.Company</td>
                        <td>@student.Package.ToString("0.0")</td>

                        <td>
                            @if (student.PlacementStatus == "Placed")
                            {
                                <span class="status placed">Placed</span>
                            }
                            else
                            {
                                <span class="status not-placed">Not Placed</span>
                            }
                        </td>

                        <td class="action-links">

                            <a asp-action="Details"
                               asp-route-id="@student.StudentID">View</a>

                            <a asp-action="Edit"
                               asp-route-id="@student.StudentID">Edit</a>

                            <a asp-action="Delete"
                               asp-route-id="@student.StudentID"
                               class="delete-link">Delete</a>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="table-footer">
        Showing @Model.Count student records
    </div>

</div>
