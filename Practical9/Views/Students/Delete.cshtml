@model Practical9.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="page-heading">
    <h1>Delete Student</h1>
    <p>Review the student information before deleting.</p>
</div>

<div class="form-section">

    <div class="delete-warning">
        Are you sure you want to delete this student?
    </div>

    <div class="detail-row">
        <span>Student ID</span>
        <strong>@Model.StudentID</strong>
    </div>

    <div class="detail-row">
        <span>Student Name</span>
        <strong>@Model.StudentName</strong>
    </div>

    <div class="detail-row">
        <span>Department</span>
        <strong>@Model.Department</strong>
    </div>

    <div class="detail-row">
        <span>Company</span>
        <strong>@Model.Company</strong>
    </div>

    <div class="detail-row">
        <span>Package</span>
        <strong>@Model.Package.ToString("0.0") LPA</strong>
    </div>

    <form asp-action="Delete" method="post" class="form-buttons">

        <input type="hidden" asp-for="StudentID" name="id" />

        <button type="submit" class="danger-btn">
            Confirm Delete
        </button>

        <a asp-action="Index" class="secondary-btn">
            Cancel
        </a>

    </form>

</div>
