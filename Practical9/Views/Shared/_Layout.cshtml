
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Placement Portal</title>

    <link rel="stylesheet"
          href="/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="topbar">

        <div class="brand">
            Placement Portal
        </div>

        <nav>
            <a asp-controller="Students"
               asp-action="Index">Dashboard</a>

            <a asp-controller="Students"
               asp-action="Create">Add Student</a>
        </nav>

    </header>

    <main class="main-container">
        @RenderBody()
    </main>

    <footer class="footer">
        Student Placement Management System
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
