@model IEnumerable<CampusServiceRequest>
@{ ViewData["Title"] = "Dashboard"; }
<section class="hero"><div><span class="eyebrow">CAMPUS OPERATIONS</span><h1>Service Request Dashboard</h1><p>Raise a request, follow its progress, and keep campus services moving.</p></div><a class="btn btn-light" asp-action="Create">＋ Create Request</a></section>
<section class="stats">
<div class="stat-card"><span>Total requests</span><strong>@ViewBag.Total</strong><small>All submitted requests</small></div>
<div class="stat-card"><span>Pending</span><strong>@ViewBag.Pending</strong><small>Awaiting action</small></div>
<div class="stat-card"><span>In progress</span><strong>@ViewBag.InProgress</strong><small>Currently being handled</small></div>
<div class="stat-card"><span>Resolved</span><strong>@ViewBag.Resolved</strong><small>Successfully completed</small></div>
</section>
<div class="section-heading"><div><h2>Campus requests</h2><p>Search and manage submitted service requests.</p></div></div>
<form method="get" asp-action="Index" class="filter-bar">
<input type="text" name="search" value="@ViewBag.Search" placeholder="Search student, title, category or email" />
<select name="status"><option value="All">All statuses</option><option value="Pending" selected="@(ViewBag.SelectedStatus as string == "Pending")">Pending</option><option value="In Progress" selected="@(ViewBag.SelectedStatus as string == "In Progress")">In Progress</option><option value="Resolved" selected="@(ViewBag.SelectedStatus as string == "Resolved")">Resolved</option></select>
<button class="btn btn-primary" type="submit">Apply filters</button><a class="btn btn-outline" asp-action="Index">Clear</a>
</form>
<div class="table-wrap"><table><thead><tr><th>Request</th><th>Student</th><th>Category</th><th>Priority</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td><strong>#@item.Id · @item.Title</strong><small>@item.Department</small></td><td>@item.StudentName<small>@item.Email</small></td><td>@item.Category</td><td><span class="priority @item.Priority.ToLowerInvariant()">@item.Priority</span></td>
<td><form asp-action="UpdateStatus" method="post" class="status-form"><input type="hidden" name="id" value="@item.Id" /><select name="status" onchange="this.form.submit()" aria-label="Change status"><option value="Pending" selected="@(item.Status == "Pending")">Pending</option><option value="In Progress" selected="@(item.Status == "In Progress")">In Progress</option><option value="Resolved" selected="@(item.Status == "Resolved")">Resolved</option></select></form></td>
<td>@item.CreatedAt.ToString("dd MMM yyyy")</td><td class="actions"><a asp-action="Details" asp-route-id="@item.Id">View</a><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="danger-link" asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>
}
@if (!Model.Any()) { <tr><td colspan="7" class="empty">No requests found. Create the first campus service request.</td></tr> }
</tbody></table></div>
