@model CampusServiceRequest
@{ ViewData["Title"] = "Create Request"; }
<div class="form-shell"><a class="back-link" asp-action="Index">← Back to dashboard</a><h1>Submit a service request</h1><p class="muted">Provide the details below. Your request will be saved to the campus database.</p>
<form asp-action="Create" method="post" class="request-form"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid">
<div><label asp-for="StudentName"></label><input asp-for="StudentName" placeholder="Enter full name" /><span asp-validation-for="StudentName"></span></div>
<div><label asp-for="Email"></label><input asp-for="Email" placeholder="student@college.edu" /><span asp-validation-for="Email"></span></div>
<div><label asp-for="Department"></label><input asp-for="Department" placeholder="e.g. Computer Science" /><span asp-validation-for="Department"></span></div>
<div><label asp-for="Category"></label><select asp-for="Category"><option>IT Support</option><option>Library</option><option>Hostel</option><option>Transport</option><option>Maintenance</option><option>Electrical</option><option>Other</option></select></div>
<div class="full"><label asp-for="Title"></label><input asp-for="Title" placeholder="Short title for your issue" /><span asp-validation-for="Title"></span></div>
<div><label asp-for="Priority"></label><select asp-for="Priority"><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select></div>
<div class="full"><label asp-for="Description"></label><textarea asp-for="Description" rows="5" placeholder="Explain the issue and where it occurred..."></textarea><span asp-validation-for="Description"></span></div>
</div><div class="form-actions"><a class="btn btn-outline" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Submit request</button></div></form></div>
