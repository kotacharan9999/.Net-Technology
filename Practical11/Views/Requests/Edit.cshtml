@model CampusServiceRequest
@{ ViewData["Title"] = "Edit Request"; }
<div class="form-shell"><a class="back-link" asp-action="Index">← Back to dashboard</a><h1>Edit request #@Model.Id</h1><p class="muted">Update the request information. Status can be changed from the dashboard.</p>
<form asp-action="Edit" method="post" class="request-form"><input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid">
<div><label asp-for="StudentName"></label><input asp-for="StudentName" /><span asp-validation-for="StudentName"></span></div><div><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div>
<div><label asp-for="Department"></label><input asp-for="Department" /><span asp-validation-for="Department"></span></div><div><label asp-for="Category"></label><select asp-for="Category"><option>IT Support</option><option>Library</option><option>Hostel</option><option>Transport</option><option>Maintenance</option><option>Electrical</option><option>Other</option></select></div>
<div class="full"><label asp-for="Title"></label><input asp-for="Title" /><span asp-validation-for="Title"></span></div><div><label asp-for="Priority"></label><select asp-for="Priority"><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select></div>
<div class="full"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea><span asp-validation-for="Description"></span></div>
</div><div class="form-actions"><a class="btn btn-outline" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save changes</button></div></form></div>
