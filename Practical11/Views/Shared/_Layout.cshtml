<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Smart Campus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-controller="Requests" asp-action="Index"><span class="brand-mark">SC</span><span>Smart Campus<small>Service Portal</small></span></a>
    <nav><a asp-controller="Requests" asp-action="Index">Dashboard</a><a asp-controller="Requests" asp-action="Create">New Request</a><a href="/api/servicerequests" target="_blank">API</a></nav>
</header>
<main class="container">
@if (TempData["Success"] is string message) { <div class="alert-success">@message</div> }
@RenderBody()
</main>
<footer>Smart Campus Service Portal · ASP.NET Core MVC + SQL Server + REST API</footer>
</body>
</html>
